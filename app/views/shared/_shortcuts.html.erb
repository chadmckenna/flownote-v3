<%
  # Every app-wide shortcut is Ctrl+Shift plus a key, so that group names the
  # chord once and lists only the keys. Paired keys follow their label's
  # "a / b", and render with a "/" between them.
  shortcut_groups = {
    "Ctrl + Shift +" => [
      [ "Search notes", [ "\\" ] ],
      [ "Back / forward", [ "[", "]" ] ],
      [ "Focus sidebar / editor", %w[H L] ],
      [ "Toggle sidebar", %w[P] ],
      [ "Edit / view note", %w[I V] ],
      [ "Note menu: publish, share, delete", %w[M] ],
      [ "Close note", %w[C] ],
      [ "This list", %w[K] ]
    ],
    "Sidebar · arrows work too" => [
      [ "Down / up", %w[j k] ],
      [ "Open / up a folder", %w[l h] ],
      [ "New note / folder", %w[a A] ],
      [ "Rename / delete", %w[r d] ],
      [ "Back to the note, or cancel", %w[Esc] ]
    ],
    "Editor · vim" => [
      [ "Save / save & close", %w[:w :x] ],
      [ "Close / view", %w[:q :v] ]
    ]
  }
%>

<dialog class="modal shortcuts-modal"
        data-controller="shortcuts"
        data-action="keydown.esc->shortcuts#close click->shortcuts#backdropClose">
  <h2 class="shortcuts-modal__title">Keyboard shortcuts</h2>

  <div class="shortcuts-modal__groups">
    <% shortcut_groups.each do |heading, shortcuts| %>
      <section class="shortcuts-modal__group">
        <h3><%= heading %></h3>
        <dl>
          <% shortcuts.each do |label, keys| %>
            <div class="shortcuts-modal__row">
              <dt><%= label %></dt>
              <dd>
                <% keys.each_with_index do |key, index| %>
                  <% if index > 0 %><span class="shortcuts-modal__or">/</span><% end %>
                  <kbd><%= key %></kbd>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>
  </div>
</dialog>
