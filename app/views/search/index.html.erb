<%= turbo_frame_tag "search_results", class: "search-modal__results" do %>
  <% if @query.blank? %>
    <% if @recent.any? %>
      <p class="search-modal__label">Recent</p>
      <ul class="file-listing">
        <%= render partial: "search/note", collection: @recent, as: :note %>
      </ul>
    <% end %>
  <% elsif @notes.empty? %>
    <p class="search-modal__empty">No notes found.</p>
  <% else %>
    <ul class="file-listing">
      <%= render partial: "search/note", collection: @notes, as: :note %>
    </ul>
  <% end %>
<% end %>
