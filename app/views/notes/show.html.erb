<div class="folder-shell__pane" data-mode="viewing" data-controller="scroll-keys anchor-scroll">
  <div class="note-bar">
    <code class="note-filename" title="<%= @note.title %>.md"><%= @note.title %>.md</code>
    <%= link_to "Edit", edit_folder_note_path(@note.folder, @note),
        data: { controller: "hotkey", action: "keydown.shift+ctrl+i@document->hotkey#click keydown.shift+ctrl+l@document->hotkey#click" },
        class: "btn btn--outline" %>
    <%= render "notes/actions_menu", note: @note, close_path: folder_or_root_path(@note.folder) %>
  </div>

  <%= render "notes/share_dialog", note: @note %>

  <article class="prose" data-controller="syntax-highlight mermaid task-list"
           data-task-list-url-value="<%= folder_note_task_path(@note.folder, @note, line: ":line") %>"><%= render_linked_markdown(@note.body, user: Current.user, from: @note, tasks: true) %></article>
</div>
