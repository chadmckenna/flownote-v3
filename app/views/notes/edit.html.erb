<div class="folder-shell__pane" data-mode="editing">
  <%# Above the form, not in its View/Close/Save bar: button_to emits a <form>,
      and that bar lives inside form_with. %>
  <menu class="btn-group">
    <%= render "notes/publish_button", note: @note %>
    <%= render "notes/share", note: @note %>
  </menu>

  <%= render "notes/form", note: @note,
                           form_url: folder_note_path(@note.folder, @note),
                           cancel_path: folder_or_root_path(@note.folder) %>
</div>
