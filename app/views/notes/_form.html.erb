<%= form_with(model: note, url: form_url, class: "note-form") do |form| %>
  <% if note.errors.any? %>
    <div role="alert" class="alert alert--error">
      <% note.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="note-bar">
    <%# Renamed from the sidebar (r), not here. %>
    <code class="note-filename" title="<%= note.title %>.md"><%= note.title %>.md</code>
    <%= link_to "View", folder_note_path(note.folder, note), data: { controller: "hotkey", action: "keydown.shift+ctrl+v@document->hotkey#click", note_nav: "view" }, class: "btn btn--outline" %>
    <%= form.submit "Save", data: { note_nav: "save" } %>
    <%= render "notes/actions_menu", note: note, close_path: cancel_path %>
  </div>

  <%= form.hidden_field :folder_id %>

  <div id="note-editor-<%= note.persisted? ? note.id : "new" %>" data-controller="vim-editor"
       data-action="keydown.shift+ctrl+i@window->vim-editor#focus:capture keydown.shift+ctrl+l@window->vim-editor#focus:capture"
       data-vim-editor-completions-value="<%= note_link_completions.to_json %>">
    <%= form.text_area :body, rows: 24, placeholder: "Write in Markdown...",
                              data: { vim_editor_target: "textarea" } %>
  </div>
<% end %>
