<%# The public URL embeds the username, so a published note whose owner has no
    username has no reachable link — render nothing rather than blow up on
    url generation. %>
<% if note.published? && note.user.username.present? %>
  <div class="share" data-controller="share">
    <button type="button" class="btn btn--outline share__button"
            aria-label="Share note" title="Share note"
            data-action="share#open"><%= render "icons/share" %></button>

    <dialog class="modal share-modal"
            data-share-target="dialog"
            data-action="keydown.esc->share#close click->share#backdropClose">
      <h2 class="share-modal__title">Share note</h2>
      <p class="share-modal__hint">Anyone with this link can read this note. Making the note private again breaks the link for good.</p>

      <div class="share-link" data-controller="clipboard">
        <input type="text" class="share-link__url" readonly aria-label="Public link"
               value="<%= public_note_url(username: note.user.username, slug: note.slug) %>"
               data-share-target="url"
               data-clipboard-target="source">
        <button type="button" class="btn btn--outline"
                data-clipboard-target="button"
                data-action="clipboard#copy">Copy</button>
      </div>
    </dialog>
  </div>
<% end %>
